NODE_ENV=development
APP_NAME=nestjs-backend-starter
APP_HOST=127.0.0.1
PORT=3000

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app:local_dev_only_change_me@localhost:5432/app
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_SECONDS=10
DB_IDLE_TIMEOUT_SECONDS=20

# Development and test may omit keys and use a process-local Ed25519 pair.
# Production must provide matching PKCS#8 private and SPKI public PEM values.
AUTH_JWT_ISSUER=https://api.example.com
AUTH_JWT_AUDIENCE=nestjs-backend-starter
AUTH_JWT_KID=local-ed25519-1
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=
# Optional JSON map of retiring kid values to SPKI PEM public keys.
AUTH_JWT_PUBLIC_KEYS=
AUTH_REFRESH_TOKEN_KEY=
# At least 43 random base64url characters in production. Keep stable across replicas.
RESOURCE_CURSOR_SECRET=local-resource-cursor-secret-change-me
RESOURCE_IDEMPOTENCY_RETENTION_HOURS=24
AUTH_REFRESH_COOKIE_SECURE=
AUTH_REFRESH_IDLE_DAYS=14
AUTH_SESSION_MAX_DAYS=30

# Production email delivery uses authenticated SMTP. Keep the password secret.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_MS=10000
# Optional trusted CA PEM for private SMTP certificate authorities.
SMTP_CA_PEM=
