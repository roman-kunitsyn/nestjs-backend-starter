{
  "name": "nestjs-backend-starter",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint src/ test/ scripts/ eslint.config.mjs jest.config.mjs jest.config.e2e.mjs",
    "lint:fix": "pnpm lint --fix",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.e2e.mjs --runInBand",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "progress:validate": "node scripts/progress.mjs validate",
    "progress:select": "node scripts/progress.mjs select",
    "progress:dashboard": "node scripts/progress.mjs dashboard",
    "progress:test": "node --test scripts/progress.test.mjs",
    "openapi:generate": "pnpm build && node scripts/openapi.mjs generate",
    "openapi:check": "node scripts/openapi.mjs check"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "fastify": "^5.12.5",
    "nestjs-pino": "^5.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "prettier": "^3.4.2",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.1"
  }
}
