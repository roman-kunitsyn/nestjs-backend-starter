{
  "name": "nestjs-backend-starter",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint src/ test/ scripts/ eslint.config.mjs jest.config.mjs jest.config.e2e.mjs jest.config.integration.mjs drizzle.config.ts drizzle.fixture.config.ts",
    "lint:fix": "pnpm lint --fix",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.e2e.mjs --runInBand",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.integration.mjs --runInBand",
    "db:generate": "drizzle-kit generate",
    "db:generate:fixture": "drizzle-kit generate --config=drizzle.fixture.config.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed:reference": "node scripts/seed.mjs reference",
    "db:seed:dev": "node scripts/seed.mjs dev",
    "db:check": "drizzle-kit check",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "progress:validate": "node scripts/progress.mjs validate",
    "progress:select": "node scripts/progress.mjs select",
    "progress:dashboard": "node scripts/progress.mjs dashboard",
    "progress:test": "node --test scripts/progress.test.mjs",
    "security:audit": "pnpm audit --prod",
    "security:scan-image": "trivy image --exit-code 1 --severity HIGH,CRITICAL nestjs-backend-starter:local",
    "openapi:generate": "pnpm build && node scripts/openapi.mjs generate",
    "openapi:check": "node scripts/openapi.mjs check"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.1.0",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "prettier": "^3.4.2",
    "smtp-server": "^3.19.21",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.1"
  }
}
