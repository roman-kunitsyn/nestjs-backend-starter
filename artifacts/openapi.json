                      "createdAt",
                      "updatedAt",
                      "membership"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "name": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "slug": {
                        "type": "string",
                        "maxLength": 100
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "active",
                          "suspended",
                          "archived"
                        ]
                      },
                      "createdAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "membership": {
                        "type": "object",
                        "required": [
                          "id",
                          "role",
                          "status"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "role": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "active",
                              "suspended"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "description": "Request correlation identifier.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List the current user’s organizations",
        "tags": [
          "Organizations"
        ]
      }
    },
